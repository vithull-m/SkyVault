# =========================================================================
# SkyVault Production Environment Variables Template
# Copy this file to .env and replace with production secrets before deploying
# =========================================================================

# Database Configuration
POSTGRES_DB=skyvault_db
POSTGRES_USER=skyvault_admin
POSTGRES_PASSWORD=SuperSecretProdPassword123!
POSTGRES_PORT=5432

# Spring Boot JWT Security Configuration
JWT_SECRET=9a2f8c4e7b1a5d3f8e6c4b2a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e
JWT_EXPIRATION_MS=86400000

# Service Port Configuration
BACKEND_PORT=8080
AI_SERVICE_PORT=8082
FRONTEND_PORT=80

# Cross-Origin Resource Sharing (CORS) Allowed Origins
CORS_ALLOWED_ORIGINS=https://skyvault.aero,https://app.skyvault.aero
