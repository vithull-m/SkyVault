# AI Service (Python / FastAPI / PyTorch / Scikit-learn) .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Unit test / coverage reports
.htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.pyo
.hypothesis/
.pytest_cache/

# Large Model Binaries & Datasets (Store in S3 / DVC / Releases instead)
*.h5
*.pkl
*.pth
*.onnx
data/raw/
data/processed/
models/*.bin
models/*.pt

# Jupyter Notebook Checkpoints
.ipynb_checkpoints

# Environment secrets
.env
.env.*
