# ==========================================
# Root .gitignore for SkyVault Monorepo
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
secrets/

# Build & Log Artifacts
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

# Node / Frontend / Hardhat Dependencies
node_modules/
dist/
build/
.cache/

# Python Virtual Environments & Compiled Files
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Java / Spring Boot Artifacts
target/
*.class
*.jar
*.war
.gradle/
build/

# Blockchain / Hardhat / Truffle Artifacts
artifacts/
cache/
coverage/
typechain/
typechain-types/

# Database / Local Volumes
postgres_data/
mysql_data/
redis_data/
