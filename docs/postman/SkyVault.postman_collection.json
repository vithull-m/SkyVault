  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "User Login (Admin / Pilot / Investigator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin_user\",\n  \"password\": \"AdminSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Register User (Admin Restricted)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"investigator_sarah\",\n  \"email\": \"sarah.mitchell@skyvault.aero\",\n  \"password\": \"InvestigatorSecret123!\",\n  \"firstName\": \"Dr. Sarah\",\n  \"lastName\": \"Mitchell\",\n  \"roles\": [\"ROLE_INVESTIGATOR\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        }
      ]
    },
